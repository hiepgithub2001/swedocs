{
  "name": "swedocs",
  "private": true,
  "type": "module",
  "description": "A software-engineering knowledge base: Markdown in, EPUB 3 books and a reader out.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm --prefix tools/md2epub run build:strict",
    "test": "npm --prefix tools/md2epub test",
    "site": "node tools/site.js",
    "dev": "node tools/serve.js",
    "browsers": "npm --prefix tools/md2epub run browsers",
    "build:private": "npm --prefix tools/md2epub run build:private",
    "pdf2md": "node tools/pdf2md/bin/pdf2md.js"
  }
}
