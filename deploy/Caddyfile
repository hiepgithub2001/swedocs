# swedocs on an Oracle Cloud Always Free VM.
#
# The site is static, so the whole job is: TLS, the right MIME types, the 404
# fallback that makes /read/<book>/<chapter> a real URL, and cache headers that
# match how the build lays its files out.
#
# Install to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy

# Replace with your own name. Caddy gets the certificate itself, on first
# request, and renews it — nothing to schedule.
#
# No domain yet? Use <your-public-ip-with-dashes>.sslip.io, which resolves to
# that IP and is a real name Let's Encrypt will issue for. The app NEEDS https:
# a service worker only runs in a secure context, so over plain http the
# offline reader — the point of the thing — silently does not work.
swedocs.example.com {
	root * /srv/swedocs
	encode zstd gzip

	# Go's table does not know these, and a reader that receives an EPUB as
	# application/octet-stream refuses to open it.
	@epub path *.epub
	header @epub Content-Type application/epub+zip

	@opf path *.opf
	header @opf Content-Type application/oebps-package+xml

	@ncx path *.ncx
	header @ncx Content-Type application/x-dtbncx+xml

	@xhtml path *.xhtml
	header @xhtml Content-Type "application/xhtml+xml; charset=utf-8"

	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json; charset=utf-8"

	# Books live under pub/<build-id>/, a hash of the packages themselves. A
	# rebuild that changes something writes a NEW directory rather than editing
	# an old file, so every URL below this point is safe to cache forever.
	@immutable path /pub/*/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The two exceptions, and the reason the scheme works: latest.json names the
	# current build, and sw.js is the app's update mechanism. A stale copy of
	# either strands a reader on an old version with no way to notice.
	@volatile path /pub/latest.json /sw.js /index.html /404.html /
	header @volatile Cache-Control "no-cache"

	file_server

	# What GitHub Pages does, reproduced: an unknown path is answered with
	# 404.html — which is a copy of the app — and keeps the 404 status. That is
	# what lets /read/system-design/caching be opened, shared and bookmarked.
	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			# `status` is what keeps this a real 404. Without it the fallback
			# is served as 200 and every typo looks to a crawler like a page.
			file_server {
				status 404
			}
		}
	}
}
